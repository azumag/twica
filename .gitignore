# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# 認証情報ファイル全般（`.env*`は「.envで始まる」ファイルのみにマッチし、
# 「~.envで終わる」ファイル名は保護されない抜け穴があったため`*.env`を追加。
# issue #691 Chunk 2でリポジトリ直下に接続文字列入りファイルが誤って
# 置かれるインシデントが発生したことを受けての対処）。
# 以前は`*credentials*.env`も追加していたが、`*.env`（直上の行）の完全な部分集合で
# 実質無意味な行だったため削除し、拡張子を問わず「credentials」を含むファイル名全般を
# 保護する`*credentials*`に置き換えた（例: credentials.json, db-credentials.txt等、
# .env以外の拡張子も保護対象に含める。N-2、Fableレビュー指摘）。
*.env
*credentials*

# E2E Test Authentication State Files
# These files contain sensitive session information
.e2e-auth-state-*.json

# vercel
.vercel

# OpenNext / Cloudflare Workers build output
.open-next/

# Wrangler local state and cache (generated by `wrangler dev` / `wrangler deploy`)
.wrangler/

# 各補助WorkerのWrangler dry-run出力。shutdown guardが生成bundleを検査するため
# CI/deploy時に作られるが、環境別成果物でありソース管理・worktree残留の対象外。
workers/*/dist/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Supabase
supabase/.temp/

# PlanetScale schema baseline: 生dump/manifestは実行のたびに再生成される作業ディレクトリ
# （scripts/db-phase2/export-public-schema.mjs の出力）。機密情報は含まないが、
# 生成物であり内容が実行ごとに変わりうるためgit管理しない。
# db/planetscale/*.sql（bootstrap.sql/public-schema.sql/grants.sql）はコミット対象
# （docs/planetscale-schema-baseline.md 参照）。
db/planetscale/.artifacts/

# 本番cutover時のpg_dumpファイル（未redactの生PIIを含む）。#699実施時、
# オーナー判断により削除せず一時保管する運用（本来のrunbook推奨は完了後削除）。
# 長期保管が必要な場合は暗号化した外部ストレージへ移すこと。
db/planetscale/.local-backups/

# Claude
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env*.local

# Local development helpers
# Keep the local zellij development helper out of repository history.
/zellij_monitor.sh

# supabase backup
.backup.sql

# Analysis Dashboard
analysis/node_modules
analysis/dist

# Codex agent worktrees / scratch clones (accidentally committed as gitlinks once;
# see fix removing 22 stray submodule entries). These are local-only working dirs
# and must never be tracked — they break Cloudflare Workers Builds' submodule clone.
.codex-*/
twica-maker-*/

# Unit-test scratch repositories. May survive SIGKILL; never commit them.
.tmp-i18n-static-keys-*/
