# ============================================================
# ローカル開発用の環境変数テンプレート
#
# セットアップ手順:
#   cp .env.local.example .env.development.local
#
# ⚠️ 重要: ファイル名は .env.development.local を使うこと。
# .env.local は next build (NODE_ENV=production) でも読み込まれるため、
# 秘密鍵がビルド成果物 (next-env.mjs) にバンドルされてしまう。
# .env.development.local は next dev (NODE_ENV=development) でのみ読み込まれる。
#
# 本番用の NEXT_PUBLIC_ 変数は .env.production.local に設定する。
# 本番用の秘密鍵は Cloudflare secrets で管理する。
# ============================================================

# PlanetScale PostgreSQL
# `npm run dev:next` が使うPlanetScale論理DBの接続文字列。
# production/previewではHYPERDRIVE_PLANETSCALE bindingを使用するため不要。
# 接続文字列にはアプリ用ロールを使用し、リポジトリへ絶対にcommitしないこと。
DATABASE_URL_PLANETSCALE=postgres://twica_app:password@your-planetscale-host/prod?sslmode=verify-full

# migration runner (`npm run db:*`) は DATABASE_URL を読む。
# ローカルでmigrationを実行するときだけ、上と同じ対象または専用migration roleを設定する。
# DATABASE_URL=postgres://migration_role:password@your-planetscale-host/prod?sslmode=verify-full

# Twitch OAuth
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
NEXT_PUBLIC_TWITCH_CLIENT_ID=your_twitch_client_id

# Twitch EventSub
TWITCH_EVENTSUB_SECRET=your_eventsub_secret

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# App
NEXT_PUBLIC_APP_URL=http://localhost:8787

# Gacha
GACHA_COST=100

# CSRF Protection
# Generate a secure random salt using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_TOKEN_SALT=your_csrf_token_salt_at_least_32_chars

# Session Cookie Signing (HMAC-SHA256)
# セッションCookieの改ざん検知に使用するシークレット（最低32文字）
# Used for HMAC-SHA256 signing of session cookies to prevent tampering.
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 本番環境ではCloudflare Secretsで設定すること。
# In production, set this via Cloudflare secrets (wrangler secret put SESSION_COOKIE_SECRET).
SESSION_COOKIE_SECRET=your_session_cookie_secret_at_least_32_chars

# CSRF Local Network Access (Development Only)
# Set to 'true' to allow requests from other devices on local network during development
# Never enable in production!
# CSRF_ALLOW_ALL_LOCAL=true

# Cloudflare R2 Storage
# R2はVercel Blobの代替として使用（操作数制限が大幅に緩い）
# R2エンドポイント（例: https://xxx.r2.cloudflarestorage.com）
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# R2アクセスキーID
R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2シークレットアクセスキー
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2バケット名（画像用）
R2_BUCKET_NAME=your_bucket_name
# R2パブリックURL（カスタムドメインまたはpub-xxx.r2.dev）
R2_PUBLIC_URL=https://your-bucket.your-domain.com
# Cloudflare R2 Storage（効果音用、すべて必須）
# 画像バケットとは完全に別のバケット・認証情報を使用
# エンドポイント(R2_ENDPOINT)は画像バケットと共通
# R2効果音アクセスキーID
R2_SOUND_ACCESS_KEY_ID=your_r2_sound_access_key_id
# R2効果音シークレットアクセスキー
R2_SOUND_SECRET_ACCESS_KEY=your_r2_sound_secret_access_key
# R2効果音バケット名
R2_SOUND_BUCKET_NAME=your_sound_bucket_name
# R2効果音パブリックURL
R2_SOUND_PUBLIC_URL=https://your-sound-bucket.your-domain.com

# Cloudflare Web Analytics (optional)
# CloudflareダッシュボードでWeb Analyticsを有効にしてトークンを取得
# 設定しない場合、アナリティクスは無効になります
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token

# runtime の DB 接続先は PlanetScale 固定。旧ドライバ切替変数は使用しない。
