{
  "name": "twica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx wrangler dev",
    "dev:next": "TURBOPACK=0 next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:unit:ui": "vitest ui",
    "test:cleanup": "pkill -9 -f vitest || true",
    "test:agent": "npm run test:cleanup && vitest run --no-watch --no-file-parallelism --pool=forks --poolOptions.forks.singleFork=true --bail 1 && npm run test:cleanup",
    "workers:build": "npx opennextjs-cloudflare build",
    "workers:dev": "npx wrangler dev",
    "workers:deploy": "npx opennextjs-cloudflare deploy",
    "workers:deploy:preview": "npx opennextjs-cloudflare deploy --env preview",
    "cloudflare:deploy:production": "bash scripts/cloudflare-workers-build-deploy.sh production deploy",
    "cloudflare:deploy:preview": "bash scripts/cloudflare-workers-build-deploy.sh preview deploy",
    "cloudflare:upload:production": "bash scripts/cloudflare-workers-build-deploy.sh production upload",
    "cloudflare:upload:preview": "bash scripts/cloudflare-workers-build-deploy.sh preview upload",
    "db:status": "node scripts/db-migrate.js status --provider=planetscale",
    "db:push": "node scripts/db-migrate.js apply --provider=planetscale",
    "db:push:dry": "node scripts/db-migrate.js plan --provider=planetscale",
    "check:migration-order": "node scripts/check-migration-order.js",
    "db:migrate:status": "node scripts/db-migrate.js status",
    "db:migrate:plan": "node scripts/db-migrate.js plan",
    "db:migrate:apply": "node scripts/db-migrate.js apply",
    "db:migrate:verify": "node scripts/db-migrate.js verify",
    "db:phase2:export": "node scripts/db-phase2/export-public-schema.mjs",
    "db:phase2:normalize": "node scripts/db-phase2/normalize-schema.mjs",
    "db:cutover:init-identity": "node scripts/db-cutover/init-identity.mjs",
    "db:cutover:verify": "node scripts/db-cutover/verify.mjs",
    "check:analysis-browser-supabase": "node scripts/check-analysis-browser-supabase.js",
    "check:supabase-shutdown": "node scripts/check-supabase-shutdown.js",
    "check:maintenance-surfaces": "node scripts/check-maintenance-surfaces.js",
    "probe:maintenance": "node scripts/probe-maintenance-write-surfaces.js",
    "replay:maintenance-eventsub": "node scripts/replay-maintenance-eventsub.js",
    "smoke-check": "node scripts/smoke-check.js",
    "migrate:vercel-to-r2": "node scripts/migrate-vercel-blob-to-r2.js",
    "migrate:vercel-to-r2:dry": "node scripts/migrate-vercel-blob-to-r2.js --dry-run",
    "error-reporter:deploy": "cd workers/error-reporter && npx wrangler deploy",
    "error-reporter:tail": "cd workers/error-reporter && npx wrangler tail"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.1.6",
    "next-intl": "^4.7.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1",
    "react-image-crop": "^11.0.10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@opennextjs/cloudflare": "^1.16.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vercel/blob": "^0.27.1",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.3.3",
    "jsdom": "^27.0.1",
    "supabase": "^2.72.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.0"
  }
}
